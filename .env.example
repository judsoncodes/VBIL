# =============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# =============================================================================
# Copy this file to `.env` in your project root and replace with your endpoints:
# cp .env.example .env
# =============================================================================

# 1. General Contact Formspree Endpoint (for /contact)
VITE_FORMSPREE_CONTACT_ENDPOINT=https://formspree.io/f/YOUR_CONTACT_FORM_ID

# 2. B2B Distributor Applications Google Sheets Web App Endpoint (for /distributors)
VITE_SHEETS_DISTRIBUTOR_ENDPOINT=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# 3. B2B Bulk Order Requests Google Sheets Web App Endpoint (for /order-request)
VITE_SHEETS_ORDER_ENDPOINT=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
